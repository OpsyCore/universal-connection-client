<?xml version="1.0" encoding="utf-8"?>
<!-- App-originated HTTP (subscriptions, probes) must be HTTPS. Per-profile TLS is handled by the core, not by this config. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- v1.0.2 real delay test: the in-process sing-box probe exposes its Clash API on 127.0.0.1 with a per-session
         random secret (Bearer). Traffic never leaves the device; loopback is the only cleartext exception. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
