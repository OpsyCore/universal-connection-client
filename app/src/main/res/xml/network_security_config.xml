<?xml version="1.0" encoding="utf-8"?>
<!-- App-originated HTTP (subscriptions, probes) must be HTTPS. Per-profile TLS is handled by the core, not by this config. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
