    <string name="settings_dns_invalid">Not a valid DNS address.</string>
    <string name="settings_dns_no_leak_claim">While connected, DNS queries from apps are captured by the tunnel and sent to the remote DNS. This has not been independently verified for DNS leaks; run a leak test yourself.</string>
    <string name="settings_section_routing">Routing</string>
    <string name="settings_bypass_private">Bypass local network</string>
    <string name="settings_bypass_private_help">Private IP ranges (LAN, printers, NAS) go direct instead of through the proxy.</string>
    <string name="settings_strict_route">Strict routing</string>
    <string name="settings_strict_route_help">While the tunnel is up, block traffic that would bypass it. This is not a kill switch: when the VPN is off, use Android’s “Block connections without VPN” in system settings.</string>
    <string name="settings_ipv6">IPv6 inside the tunnel</string>
    <string name="settings_notification_speed">Speed in notification</string>
    <string name="settings_notification_speed_help">Shows live download/upload rates in the connection notification while connected (updates once per second, silently). Hidden automatically when the tunnel is not connected.</string>
    <string name="settings_section_network_tweaks">Network tweaks</string>
    <string name="settings_tls_fragment">TLS fragment</string>
    <string name="settings_tls_fragment_help">Splits the TLS handshake to the proxy server into several pieces (sing-box fragment + record_fragment). Helps only against simple SNI filtering, slows down connecting, and is not applied to REALITY or QUIC-based servers.</string>
    <string name="settings_block_quic">Block QUIC (HTTP/3)</string>
    <string name="settings_block_quic_help">Rejects QUIC inside the tunnel so apps such as YouTube fall back to TCP, which is often faster through a proxy. Apps that only speak QUIC will stop working while this is on.</string>
    <string name="settings_fake_dns">FakeDNS</string>
    <string name="settings_fake_dns_help">Answers DNS queries inside the tunnel with placeholder addresses (198.18.0.0/15) so connections start without waiting for a real lookup and routing rules see domain names. Local names (.local, .lan, .home.arpa …) keep using real DNS. Some apps cache these placeholder addresses; reconnecting the app fixes that.</string>
    <string name="settings_network_tweaks_note">Both switches change the sing-box config on the next connect only. Leave them off unless you have a specific problem.</string>
    <string name="settings_ipv6_help">Disable if sites fail to load on IPv6-only paths.</string>
