    <!-- v1.0.2: smart routing + servers settings -->
    <string name="settings_section_smart_routing">مسیریابی هوشمند</string>
    <string name="settings_direct_iran">عبور مستقیم ترافیک ایران</string>
    <string name="settings_direct_iran_help">سایت‌های ایرانی (geosite-ir) و بازه‌های IP ایران (geoip-ir) بدون پروکسی و با DNS مستقیم باز می‌شوند. از قواعد همراه برنامه استفاده می‌شود (تاریخ نسخه در بخش مجوزها).</string>
    <string name="settings_block_ads">مسدودسازی تبلیغات</string>
    <string name="settings_block_ads_help">اتصال‌ها و درخواست‌های DNS دامنه‌های شناخته‌شدهٔ تبلیغات و ردیاب (geosite-category-ads-all) رد می‌شوند. مسدودکنندهٔ کامل نیست؛ تبلیغاتی که از دامنهٔ خود سرویس می‌آیند همچنان بارگذاری می‌شوند.</string>
    <string name="settings_smart_routing_note">هر دو در اتصال بعدی اعمال می‌شوند. قواعد فایل‌های محلی هستند و چیزی دانلود نمی‌شود. قوانین مسیریابی خودتان همچنان بر قواعد ایران اولویت دارند.</string>
    <string name="settings_section_servers">سرورها</string>
    <string name="settings_real_delay_test">تست تأخیر واقعی (HTTP)</string>
