<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon. Layers are rasterised from branding/logo-source.png (shield artwork only; the
     wordmark is illegible at launcher sizes and would be cut by launcher masks). The shield sits inside the
     66 dp safe zone so circle / squircle / rounded-square masks never clip it. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
